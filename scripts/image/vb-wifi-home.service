[Unit]
Description=VectorBridge: rejoin the home Wi-Fi network at boot and after it drops, if one is marked and in range
# network-online: NetworkManager has finished its boot autoconnect, so the access point is up.
After=network-online.target persist.mount vb-firstboot.service vb-ap-apply.service
Wants=network-online.target

[Service]
# Let the access point settle before the scan.
ExecStartPre=/bin/sleep 3
# Scans (about 20 s) plus a join at boot, then a look every few seconds: a home network that
# drops is rejoined once it is back in range (never after "Back to the access point").
ExecStart=/opt/vector-bridge/venv/bin/python -m vector_bridge.wifijoin home
Restart=always
RestartSec=10
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
